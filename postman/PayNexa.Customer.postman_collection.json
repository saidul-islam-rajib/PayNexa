              "query": [
                {
                  "key": "page",
                  "value": "{{page}}"
                },
                {
                  "key": "page-size",
                  "value": "{{pageSize}}"
                }
              ]
            },
            "description": "Same list routed through YARP; the gateway forwards `X-Correlation-Id`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Correlation id is echoed\", () => pm.expect(pm.response.headers.get(\"X-Correlation-Id\")).to.eql(pm.environment.get(\"correlationId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get customer by id via gateway",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/{{apiVersion}}/customers/{{customerId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "{{apiVersion}}",
                "customers",
                "{{customerId}}"
              ]
            },
            "description": "Single customer through the gateway."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Correlation id is echoed\", () => pm.expect(pm.response.headers.get(\"X-Correlation-Id\")).to.eql(pm.environment.get(\"correlationId\")));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
