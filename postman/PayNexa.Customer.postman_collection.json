{
  "info": {
    "name": "PayNexa - Customer API",
    "description": "Every Customer API endpoint for the local environment. Select the **PayNexa - Local** environment first.\n\nRun the folders top to bottom (or use the Collection Runner): **Register customer** stores the new `customerId` and `customerEmail` in the environment, and every later request uses them.\n\nEach request sends `X-Correlation-Id: {{correlationId}}` (a new value per request), so you can paste it into Seq (`CorrelationId = '...'`) to see the full server-side log trail.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.environment.set(\"correlationId\", \"postman-\" + Date.now() + \"-\" + Math.floor(Math.random() * 100000));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "console.log(pm.info.requestName + \" -> \" + pm.response.code + \" | CorrelationId = \" + pm.environment.get(\"correlationId\"));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Registration",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "{{apiVersion}}",
                "customers"
              ]
            },
            "description": "Registers a customer (address optional). Generates a unique email and phone so it can run repeatedly. Saves `customerId` and `customerEmail` to the environment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"{{firstName}}\",\n  \"lastName\": \"{{lastName}}\",\n  \"email\": \"{{uniqueEmail}}\",\n  \"phoneNumber\": \"{{uniquePhone}}\",\n  \"dateOfBirth\": \"{{dateOfBirth}}\",\n  \"address\": {\n    \"line1\": \"{{addressLine1}}\",\n    \"line2\": null,\n    \"city\": \"{{addressCity}}\",\n    \"state\": null,\n    \"postalCode\": \"{{addressPostalCode}}\",\n    \"countryCode\": \"{{addressCountryCode}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"uniqueEmail\", \"nadia.\" + Date.now() + \"@example.com\");",
                  "pm.environment.set(\"uniquePhone\", \"+8801711\" + String(Math.floor(100000 + Math.random() * 900000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Correlation id is echoed\", () => pm.expect(pm.response.headers.get(\"X-Correlation-Id\")).to.eql(pm.environment.get(\"correlationId\")));",
                  "pm.test(\"Location header is returned\", () => pm.response.to.have.header(\"Location\"));",
                  "const body = pm.response.json();",
                  "if (body && body.id) {",
                  "    pm.environment.set(\"customerId\", body.id);",
                  "    pm.environment.set(\"customerEmail\", body.email);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Queries",
      "item": [
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/customers?page={{page}}&page-size={{pageSize}}&sort-by=created-at&sort-order=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "{{apiVersion}}",
                "customers"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "{{page}}"
                },
                {
                  "key": "page-size",
                  "value": "{{pageSize}}"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "Active",
                  "disabled": true
                },
                {
                  "key": "kyc-status",
                  "value": "Pending",
                  "disabled": true
                },
                {
                  "key": "sort-by",
                  "value": "created-at"
                },
                {
                  "key": "sort-order",
                  "value": "desc"
                }
              ]
            },
            "description": "Paged list from the MongoDB read model. Enable `search`, `status` (Active | Suspended | Closed) or `kyc-status` (Pending | Verified | Rejected) to filter. `sort-by`: created-at | updated-at | first-name | last-name | email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Correlation id is echoed\", () => pm.expect(pm.response.headers.get(\"X-Correlation-Id\")).to.eql(pm.environment.get(\"correlationId\")));",
                  "pm.test(\"Paged result\", () => pm.expect(pm.response.json()).to.have.property(\"items\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get customer by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "{{apiVersion}}",
                "customers",
                "{{customerId}}"
              ]
            },
            "description": "Reads one customer (Redis cache, then MongoDB read model). Right after registration the read model may need a second to catch up (outbox); retry if you get 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Correlation id is echoed\", () => pm.expect(pm.response.headers.get(\"X-Correlation-Id\")).to.eql(pm.environment.get(\"correlationId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Lookup customer by email",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/customers/lookup?email={{customerEmail}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "{{apiVersion}}",
                "customers",
                "lookup"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "{{customerEmail}}"
                }
              ]
            },
            "description": "Finds a customer by email in the read model."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Correlation id is echoed\", () => pm.expect(pm.response.headers.get(\"X-Correlation-Id\")).to.eql(pm.environment.get(\"correlationId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get payment eligibility",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/customers/{{customerId}}/payment-eligibility",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "{{apiVersion}}",
                "customers",
                "{{customerId}}",
                "payment-eligibility"
              ]
            },
            "description": "Can this customer pay? Read from SQL Server (source of truth). Eligible only when status is Active and KYC is Verified; otherwise `reasons` explains why."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Correlation id is echoed\", () => pm.expect(pm.response.headers.get(\"X-Correlation-Id\")).to.eql(pm.environment.get(\"correlationId\")));",
                  "pm.test(\"Has isEligible\", () => pm.expect(pm.response.json()).to.have.property(\"isEligible\"));"
                ]
              }
            }
          ]
        }
      ]
    },
