{
  "Service": {
    "Name": "api-gateway"
  },
  "PayNexaLogging": {
    "ConsoleFormat": "Text",
    "SeqServerUrl": "",
    "RetainedFileCount": 7
  },
  "Observability": {
    "OtlpTracesEndpoint": null,
    "OtlpMetricsEndpoint": null
  },
  "ReverseProxy": {
    "Routes": {
      "authentication-route": {
        "ClusterId": "authentication",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "customer-route": {
        "ClusterId": "customer",
        "Match": { "Path": "/api/v1/customers/{**catch-all}" }
      },
      "payment-route": {
        "ClusterId": "payment",
        "Match": { "Path": "/api/v1/payments/{**catch-all}" }
      },
      "transaction-route": {
        "ClusterId": "transaction",
        "Match": { "Path": "/api/v1/transactions/{**catch-all}" }
      }
    },
    "Clusters": {
      "authentication": {
        "Destinations": {
          "primary": { "Address": "http://authentication.api:8080" }
        }
      },
      "customer": {
        "Destinations": {
          "primary": { "Address": "http://customer.api:8080" }
        }
      },
      "payment": {
        "Destinations": {
          "primary": { "Address": "http://payment.api:8080" }
        }
      },
      "transaction": {
        "Destinations": {
          "primary": { "Address": "http://transaction.api:8080" }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
