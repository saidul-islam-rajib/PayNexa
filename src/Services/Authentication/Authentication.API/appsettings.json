{
  "Service": {
    "Name": "authentication-service"
  },
  "ConnectionStrings": {
    "AuthDb": ""
  },
  "SqlServer": {
    "MaxRetryCount": 5,
    "MaxRetryDelay": "00:00:10"
  },
  "MongoDb": {
    "ConnectionString": "",
    "DatabaseName": "paynexa_auth"
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Kafka": {
    "BootstrapServers": "",
    "TopicPartitions": 3,
    "TopicReplicationFactor": 1,
    "MessageTimeoutMs": 10000
  },
  "Outbox": {
    "PollingInterval": "00:00:01",
    "BatchSize": 50,
    "MaxAttempts": 20,
    "MaxRetryDelay": "00:05:00"
  },
  "OperationLogging": {
    "SlowOperationThresholdMs": 500
  },
  "PayNexaLogging": {
    "ConsoleFormat": "Text",
    "SeqServerUrl": "",
    "RetainedFileCount": 7
  },
  "Observability": {
    "OtlpTracesEndpoint": null,
    "OtlpMetricsEndpoint": null
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://auth.paynexa.local",
    "Audience": "paynexa-api",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00",
    "SigningKeyVaultPath": "secret/data/paynexa/authentication/jwt-signing-key"
  },
  "Authentication": {
    "MaxFailedLoginAttempts": 5,
    "LockoutDuration": "00:15:00",
    "Password": {
      "MinimumLength": 12,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireSymbol": true
    }
  }
}
