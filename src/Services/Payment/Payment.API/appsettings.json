{
  "Service": {
    "Name": "payment-service"
  },
  "ConnectionStrings": {
    "PaymentDb": ""
  },
  "SqlServer": {
    "MaxRetryCount": 5,
    "MaxRetryDelay": "00:00:10"
  },
  "MongoDb": {
    "ConnectionString": "",
    "DatabaseName": "paynexa_payment"
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Kafka": {
    "BootstrapServers": "",
    "TopicPartitions": 3,
    "TopicReplicationFactor": 1,
    "MessageTimeoutMs": 10000
  },
  "Outbox": {
    "PollingInterval": "00:00:01",
    "BatchSize": 50,
    "MaxAttempts": 20,
    "MaxRetryDelay": "00:05:00"
  },
  "OperationLogging": {
    "SlowOperationThresholdMs": 500
  },
  "PayNexaLogging": {
    "ConsoleFormat": "Text",
    "SeqServerUrl": "",
    "RetainedFileCount": 7
  },
  "Observability": {
    "OtlpTracesEndpoint": null,
    "OtlpMetricsEndpoint": null
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Payment": {
    "DefaultCurrency": "BDT",
    "SupportedCurrencies": [ "BDT", "USD", "EUR" ],
    "MinimumAmount": 1.00,
    "MaximumAmount": 1000000.00,
    "IdempotencyKeyTimeToLive": "1.00:00:00"
  },
  "Services": {
    "CustomerService": {
      "BaseAddress": "http://localhost:5001",
      "AttemptTimeout": "00:00:05",
      "TotalRequestTimeout": "00:00:15"
    }
  }
}
