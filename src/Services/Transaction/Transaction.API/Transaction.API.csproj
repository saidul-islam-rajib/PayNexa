  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\PayNexa.AspNetCore\PayNexa.AspNetCore.csproj" />
    <ProjectReference Include="..\Transaction.Application\Transaction.Application.csproj" />
