{
  "Service": {
    "Name": "transaction-service"
  },
  "ConnectionStrings": {
    "TransactionDb": ""
  },
  "SqlServer": {
    "MaxRetryCount": 5,
    "MaxRetryDelay": "00:00:10"
  },
  "MongoDb": {
    "ConnectionString": "",
    "DatabaseName": "paynexa_transaction"
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Kafka": {
    "BootstrapServers": "",
    "TopicPartitions": 3,
    "TopicReplicationFactor": 1,
    "MessageTimeoutMs": 10000
  },
  "Outbox": {
    "PollingInterval": "00:00:01",
    "BatchSize": 50,
    "MaxAttempts": 20,
    "MaxRetryDelay": "00:05:00"
  },
  "OperationLogging": {
    "SlowOperationThresholdMs": 500
  },
  "PayNexaLogging": {
    "ConsoleFormat": "Text",
    "SeqServerUrl": "",
    "RetainedFileCount": 7,
    "HttpBodies": {
      "Enabled": false,
      "MaxLoggedLength": 4096,
      "MaxCapturedBytes": 1048576
    }
  },
  "Observability": {
    "OtlpTracesEndpoint": null,
    "OtlpMetricsEndpoint": null
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Transaction": {
    "LedgerCurrencyPrecision": 2,
    "ConsumerGroupId": "transaction-service",
    "SubscribedTopics": [ "paynexa.payment" ]
  }
}
